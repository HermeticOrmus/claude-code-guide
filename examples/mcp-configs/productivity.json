{
  "mcpServers": {
    "google-calendar": {
      "comment": "Google Calendar management",
      "command": "npx",
      "args": [
        "-y",
        "@cocal/google-calendar-mcp"
      ],
      "env": {
        "GOOGLE_OAUTH_CREDENTIALS": "/path/to/gcp-oauth.keys.json"
      }
    },
    "todoist": {
      "comment": "Todoist task management - OAuth via browser on first use: claude mcp login todoist",
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "obsidian": {
      "comment": "Obsidian notes - requires the Local REST API plugin. Python package, run with uvx (from uv)",
      "command": "uvx",
      "args": [
        "mcp-obsidian"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "your-api-key",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      }
    }
  }
}
